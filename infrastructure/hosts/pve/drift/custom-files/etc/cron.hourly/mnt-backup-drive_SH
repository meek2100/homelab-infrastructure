#!/bin/sh

# Set the log file
log_file="/etc/cron.hourly/backup-drive.log"

# Function to log messages (POSIX-compliant)
log_message() {
  date_str=$(date +%Y-%m-%d\ %H:%M:%S) # Use command substitution
  printf "%s: %s\n" "$date_str" "$*" >> "$log_file"
}

