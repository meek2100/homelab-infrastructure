# Drive and mount point
DRIVE_ID="41d79ae9-1b08-4340-bd07-fa29fb713f6a"
MOUNT_POINT="/mnt/pve/backup"


# Check if mounted (POSIX-compliant using `mount` and `grep`)
if mount | grep -q "$MOUNT_POINT"; then
  log_message "$MOUNT_POINT is already mounted."
else
  log_message "$MOUNT_POINT is unmounted, attempting to mount now..."

  if mount UUID="$DRIVE_ID" "$MOUNT_POINT"; then
    log_message "$MOUNT_POINT was mounted successfully."
  else
    log_message "Failed to mount $MOUNT_POINT. Check device, UUID, permissions, and logs (e.g., dmesg)."
    exit 1
  fi
fi

exit 0