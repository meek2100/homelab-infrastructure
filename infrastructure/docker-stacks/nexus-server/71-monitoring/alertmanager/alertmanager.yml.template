global:
  resolve_timeout: 5m
  smtp_smarthost: '${SMTP_SMARTHOST}'
  smtp_from: '${SMTP_FROM}'
  smtp_auth_username: '${SMTP_USER}'
  smtp_auth_password: '${SMTP_PASS}'
  smtp_require_tls: true

route:
  group_by: ['alertname', 'instance', 'severity']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: 'pushover-default'
  routes:
    - match:
        severity: critical
      receiver: 'pushover-critical'
      continue: true
    - match:
        severity: critical
      receiver: 'email-critical'
    - match:
        severity: warning
      receiver: 'email-warning'

receivers:
  - name: 'pushover-default'
    pushover_configs:
      - user_key: '${PUSHOVER_USER_KEY}'
        token: '${PUSHOVER_APP_TOKEN}'
        title: 'Homelab Alert: {{ .CommonLabels.alertname }}'
        message: '{{ .CommonAnnotations.summary }}\n{{ .CommonAnnotations.description }}'
        priority: '0'

  - name: 'pushover-critical'
    pushover_configs:
      - user_key: '${PUSHOVER_USER_KEY}'
        token: '${PUSHOVER_APP_TOKEN}'
        title: '🚨 CRITICAL Homelab Alert: {{ .CommonLabels.alertname }}'
        message: '{{ .CommonAnnotations.summary }}\n{{ .CommonAnnotations.description }}'
        priority: '1'
        sound: 'siren'

  - name: 'email-critical'
    email_configs:
      - to: '${SMTP_TO}'
        send_resolved: true
        headers:
          Subject: '🚨 [CRITICAL] Homelab: {{ .CommonLabels.alertname }}'

  - name: 'email-warning'
    email_configs:
      - to: '${SMTP_TO}'
        send_resolved: true
        headers:
          Subject: '⚠️ [WARNING] Homelab: {{ .CommonLabels.alertname }}'
