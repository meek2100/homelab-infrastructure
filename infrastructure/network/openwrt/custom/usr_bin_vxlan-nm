#!/bin/sh
# /usr/bin/vxlan-nm - VXLAN Tunnel Manager for OpenWRT
# Maintains the vxlan150 interface and monitors remote VTEP health.
# Bridge membership is managed exclusively by failover.sh.

CONF_FILE="/etc/vxlan-nm.conf"
[ -f "$CONF_FILE" ] && . "$CONF_FILE"

# Defaults
: "${PHYSICAL_IF:=wan}"
: "${VXLAN_IF:=vxlan150}"
: "${VXLAN_VNI:=150}"
: "${DST_PORT:=4789}"
: "${LOCAL_IP:=192.168.1.226}"
: "${REMOTE_IP:=192.168.1.150}"
: "${CHECK_INTERVAL:=15}"
: "${FAIL_THRESHOLD:=3}"
: "${MTU:=1450}"
: "${LOG_FILE:=/var/log/vxlan-nm.log}"

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG_FILE"
    logger -t vxlan-nm "$*"
}

delete_vxlan() {
    ip link del "$VXLAN_IF" 2>/dev/null
}

create_vxlan() {
    if ! ip link show "$VXLAN_IF" >/dev/null 2>&1; then
        log "Creating VXLAN $VXLAN_IF (VNI $VXLAN_VNI) on $PHYSICAL_IF"
        ip link add "$VXLAN_IF" type vxlan id "$VXLAN_VNI" dev "$PHYSICAL_IF" dstport "$DST_PORT" local "$LOCAL_IP" remote "$REMOTE_IP" 2>/dev/null || \
        ip link add "$VXLAN_IF" type vxlan id "$VXLAN_VNI" dstport "$DST_PORT" local "$LOCAL_IP" remote "$REMOTE_IP"
        ip link set "$VXLAN_IF" mtu "$MTU"
        ip link set "$VXLAN_IF" up
    fi
    # Ensure bridge vlan filtering is enabled
    ip link set dev br-lan type bridge vlan_filtering 1 2>/dev/null || true
    # Enslave vxlan150 to br-lan for split trunking
    if ! bridge link | grep -q "$VXLAN_IF"; then
        ip link set dev "$VXLAN_IF" master br-lan
    fi
    # Always maintain br-lan at MTU 1500 during P1 so native VLAN 1 never stalls
    if [ ! -f /tmp/failover_p2_active ]; then
        ip link set dev br-lan mtu 1500 2>/dev/null || true
    fi
    # Ensure VID 1 is NOT on vxlan150 unless P2 is active (failover.sh manages VID 1)
    if [ ! -f /tmp/failover_p2_active ]; then
        bridge vlan del dev "$VXLAN_IF" vid 1 2>/dev/null || true
    fi
    # Ensure tagged VLANs are on vxlan150 and lan4
    for vid in 10 20 30 40 100 150 200; do
        bridge vlan add dev "$VXLAN_IF" vid "$vid" 2>/dev/null || true
        bridge vlan add dev lan4 vid "$vid" 2>/dev/null || true
    done
}

check_health() {
    # Verify tunnel endpoint is reachable over the bridge (wan)
    if ping -c 2 -W 2 -I br-lan "$REMOTE_IP" >/dev/null 2>&1; then
        return 0
    else
        return 1
    fi
}

main_loop() {
    log "VXLAN Tunnel Manager started (Backhaul: $PHYSICAL_IF, VTEP: $REMOTE_IP)."
    FAILS=0

    while :; do
        create_vxlan

        if check_health; then
            FAILS=0
        else
            FAILS=$((FAILS + 1))
            log "Remote VTEP ($REMOTE_IP) unreachable ($FAILS/$FAIL_THRESHOLD)"
            if [ "$FAILS" -ge "$FAIL_THRESHOLD" ]; then
                log "Resetting VXLAN interface..."
                delete_vxlan
                FAILS=0
            fi
        fi

        sleep "$CHECK_INTERVAL"
    done
}

mkdir -p "$(dirname "$LOG_FILE")"
main_loop
