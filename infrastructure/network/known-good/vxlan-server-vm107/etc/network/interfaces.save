sudo nano /etc/network/interfaces# This file describes the network interfaces available on your system
# and how to activate them. For more information, see interfaces(5).

source /etc/network/interfaces.d/*

# The loopback network interface
auto lo
iface lo inet loopback

# The primary network interface (now part of the bridge)
auto ens18
iface ens18 inet manual
    # No IP address on ens18 directly

# The bridge interface
auto br0
iface br0 inet dhcp
    bridge-ports ens18 vxlan42
    bridge-stp off
    bridge-fd 0

# VXLAN Interface - Currently managed by systemd with vxlan42.service
