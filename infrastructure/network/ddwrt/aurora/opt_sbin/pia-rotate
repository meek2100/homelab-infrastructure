#!/bin/sh
export PATH="/opt/bin:/opt/sbin:/bin:/sbin:/usr/bin:/usr/sbin"
echo "--> Forcing instant PIA WireGuard rotation..."

# 1. Kill the currently running watchdog instances cleanly
killall -9 pia-watchdog 2>/dev/null || true
rm -rf /tmp/pia_watchdog.lock 2>/dev/null || true
sleep 1

# 2. Immediately enforce fail-closed killswitch BEFORE tearing down interface
touch /tmp/pia_recovery.active 2>/dev/null || true
wan_if=$(nvram get wan_iface)
if [ -n "$wan_if" ]; then
    iptables -C FORWARD -i br0 -o "$wan_if" -j REJECT 2>/dev/null || iptables -I FORWARD -i br0 -o "$wan_if" -j REJECT
fi
# Re-ensure Luna transit subnet (10.20.20.0/24) stays at Rules 1 & 2 above the killswitch
iptables -D FORWARD -d 10.20.20.0/24 -j ACCEPT 2>/dev/null || true
iptables -D FORWARD -s 10.20.20.0/24 -j ACCEPT 2>/dev/null || true
iptables -I FORWARD 1 -d 10.20.20.0/24 -j ACCEPT
iptables -I FORWARD 1 -s 10.20.20.0/24 -j ACCEPT
iptables -t nat -C POSTROUTING -d 10.20.20.0/24 -j MASQUERADE 2>/dev/null || iptables -t nat -I POSTROUTING 1 -d 10.20.20.0/24 -j MASQUERADE


# 3. Take down the tunnel (Forces watchdog into fresh rotation)
ip link set oet1 down 2>/dev/null || ifconfig oet1 down 2>/dev/null || true

# 4. Start a fresh watchdog daemon (It will immediately see oet1 is down and rotate)
/opt/sbin/pia-watchdog > /tmp/pia-startup-crash.log 2>&1 &

echo "--> Rotation triggered with zero-leak fail-closed lock! WireGuard will recover in ~15-30s."

