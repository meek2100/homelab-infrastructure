#!/bin/sh
export PATH="/opt/bin:/opt/sbin:/bin:/sbin:/usr/bin:/usr/sbin"
# ==============================================================================
#
# Title:        PIA WireGuard Auto-Recovery Watchdog (DD-WRT) - POSIX NATIVE
# Description:  A continuous background daemon that monitors a single PIA
#               WireGuard tunnel (oet1). If the tunnel fails, it engages a
#               strict LAN killswitch, waits for raw internet to return,
#               refreshes the certificate, and restores connectivity.
#
# ==============================================================================

set -e

# === CONFIGURATION ===
readonly SCRIPT_DIR="/opt/etc/pia-update"
readonly CRED_FILE="$SCRIPT_DIR/pia_creds.conf"
readonly CERT_FILE="$SCRIPT_DIR/ca.rsa.4096.crt"
readonly LOCK_DIR="/tmp/pia_watchdog.lock"

# IPs and Timers
readonly VPN_CHECK_IP="10.0.0.242" # Internal PIA DNS to verify tunnel health
readonly RAW_CHECK_IP="9.9.9.9"    # Quad9 Swiss Anycast IP to verify ISP health
readonly HEALTH_CHECK_INTERVAL=60  # Seconds between healthy tunnel checks
readonly BACKOFF_BASE=15           # Starting seconds for outage backoff
readonly MAX_BACKOFF=3600          # Max backoff time (1 hour) during deep outages

# PIA API Endpoints (Spanning both v7 and v6 for maximum server diversity)
readonly PIA_SERVERLIST_V7_URL="https://serverlist.piaservers.net/vpninfo/servers/v7"
readonly PIA_SERVERLIST_V6_URL="https://serverlist.piaservers.net/vpninfo/servers/v6"
readonly PIA_TOKEN_URL="https://www.privateinternetaccess.com/api/client/v2/token"
readonly PIA_CA_CERT_URL="https://raw.githubusercontent.com/pia-foss/manual-connections/master/ca.rsa.4096.crt"
# 10 High-Speed, Privacy-Centric European Physical Regions
readonly PIA_REGION_IDS="swiss is no sweden fi denmark nl_amsterdam ro austria belgium"

# --- POSIX / BusyBox Random Generator ---
get_random_num() {
    local max="$1"
    local rnd=""
    if [ -c /dev/urandom ]; then
        rnd=$(hexdump -n 2 -e '/2 "%u"' /dev/urandom 2>/dev/null || od -An -N2 -i /dev/urandom 2>/dev/null | tr -d ' ' || echo "")
    fi
    if [ -z "$rnd" ]; then
        rnd=$(date +%s 2>/dev/null | cut -c6-10 || echo "1")
    fi
    echo $(( rnd % max ))
}

# --- Global Variables ---
PIA_USER=""
PIA_PASS=""
PUSHOVER_TOKEN=""
PUSHOVER_USER=""
TUNNEL_IF="oet1"

# --- Core Setup Functions ---

acquire_lock() {
    if ! mkdir "$LOCK_DIR" 2>/dev/null; then
        echo "Watchdog is already running. Exiting."
        exit 1
    fi
    trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT INT TERM
}

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1"
    logger -t "PIA_Watchdog" " $1"
}

send_pushover() {
    local title="$1"
    local message="$2"
    local priority="${3:-0}"

    if [ -n "$PUSHOVER_TOKEN" ] && [ -n "$PUSHOVER_USER" ]; then
        curl --connect-timeout 10 --max-time 15 -s -F "token=$PUSHOVER_TOKEN" \
            -F "user=$PUSHOVER_USER" -F "title=$title" -F "message=$message" \
            -F "priority=$priority" "https://api.pushover.net/1/messages.json" > /dev/null 2>&1 || true
    fi
}

load_credentials() {
    if [ ! -f "$CRED_FILE" ]; then
        log_msg "ERROR: Credentials file not found at $CRED_FILE"
        exit 1
    fi
    # shellcheck source=/dev/null
    . "$CRED_FILE"
}

# --- Killswitch & Routing Functions ---

ensure_luna_access() {
    # Ensure Luna transit subnet (10.20.20.0/24) is always priority Rules 1 & 2 in FORWARD
    iptables -D FORWARD -d 10.20.20.0/24 -j ACCEPT 2>/dev/null || true
    iptables -D FORWARD -s 10.20.20.0/24 -j ACCEPT 2>/dev/null || true
    iptables -I FORWARD 1 -d 10.20.20.0/24 -j ACCEPT
    iptables -I FORWARD 1 -s 10.20.20.0/24 -j ACCEPT

    # Ensure NAT masquerade for Luna transit subnet is active
    if ! iptables -t nat -C POSTROUTING -d 10.20.20.0/24 -j MASQUERADE 2>/dev/null; then
        iptables -t nat -I POSTROUTING 1 -d 10.20.20.0/24 -j MASQUERADE
    fi
}

block_lan_internet() {
    local wan_if
    wan_if=$(nvram get wan_iface)
    touch /tmp/pia_recovery.active 2>/dev/null || true

    # 1. Permanently isolate LAN from physical WAN (Fail-Closed Killswitch)
    if [ -n "$wan_if" ]; then
        if ! iptables -C FORWARD -i br0 -o "$wan_if" -j REJECT 2>/dev/null; then
            iptables -I FORWARD -i br0 -o "$wan_if" -j REJECT
            ensure_luna_access
            log_msg "Killswitch ENGAGED. LAN isolated from physical WAN."
        fi

        # Block IPv6 on physical WAN if present
        if command -v ip6tables >/dev/null 2>&1; then
            if ! ip6tables -C FORWARD -i br0 -o "$wan_if" -j REJECT 2>/dev/null; then
                ip6tables -I FORWARD -i br0 -o "$wan_if" -j REJECT 2>/dev/null || true
            fi
        fi

        # 2. Block arbitrary local router egress on physical WAN during rotation/recovery
        # Only allow: DNS (53), HTTPS (443), PIA API (1337), WireGuard (1337/51820), ICMP, and Transit subnets
        iptables -N WAN_EGRESS_FILTER 2>/dev/null || true
        iptables -F WAN_EGRESS_FILTER 2>/dev/null || true
        iptables -A WAN_EGRESS_FILTER -p udp --dport 53 -j ACCEPT
        iptables -A WAN_EGRESS_FILTER -p tcp --dport 53 -j ACCEPT
        iptables -A WAN_EGRESS_FILTER -p tcp --dport 443 -j ACCEPT
        iptables -A WAN_EGRESS_FILTER -p tcp --dport 1337 -j ACCEPT
        iptables -A WAN_EGRESS_FILTER -p udp --dport 1337 -j ACCEPT
        iptables -A WAN_EGRESS_FILTER -p udp --dport 51820 -j ACCEPT
        iptables -A WAN_EGRESS_FILTER -p icmp -j ACCEPT
        iptables -A WAN_EGRESS_FILTER -d 10.20.20.0/24 -j ACCEPT
        iptables -A WAN_EGRESS_FILTER -d 10.25.25.0/24 -j ACCEPT
        iptables -A WAN_EGRESS_FILTER -j REJECT
        if ! iptables -C OUTPUT -o "$wan_if" -j WAN_EGRESS_FILTER 2>/dev/null; then
            iptables -I OUTPUT -o "$wan_if" -j WAN_EGRESS_FILTER
        fi
    fi
}

unblock_lan_internet() {
    local wan_if
    wan_if=$(nvram get wan_iface)
    rm -f /tmp/pia_recovery.active 2>/dev/null || true

    # Remove local router egress filter on physical WAN once WireGuard is active
    if [ -n "$wan_if" ]; then
        iptables -D OUTPUT -o "$wan_if" -j WAN_EGRESS_FILTER 2>/dev/null || true
    fi

    # NOTE: The 'FORWARD -i br0 -o $wan_if -j REJECT' rule is NEVER deleted!
    # Valid VPN traffic routes via oet1 (not $wan_if), so keeping this rule permanently
    # ensures 100% fail-closed protection even during abrupt kernel interface teardown.
    log_msg "Tunnel operational. Killswitch permanently active on physical WAN."
}


disable_tunnel() {
    log_msg "Tearing down tunnel $TUNNEL_IF..."
    nvram set "${TUNNEL_IF}_en=0"
    nvram set "${TUNNEL_IF}_failgrp=0"
    nvram commit
    stopservice "$TUNNEL_IF" 2>/dev/null || true
    ip link delete "$TUNNEL_IF" 2>/dev/null || true
    killall wg_watchdog 2>/dev/null || true
}

# --- PIA Provisioning Functions ---

get_pia_config() {
    local tmp_v7="/tmp/pia_server_list_v7.$$.tmp"
    local tmp_v6="/tmp/pia_server_list_v6.$$.tmp"
    local tmp_merged="/tmp/pia_server_list_merged.$$.tmp"

    log_msg "Generating new WireGuard key pair..."
    local privkey pubkey
    privkey=$(wg genkey)
    pubkey=$(echo "$privkey" | wg pubkey)

    # Fetch both v7 and v6 server lists to maximize server choices
    curl --max-time 20 -s -o "$tmp_v7" "$PIA_SERVERLIST_V7_URL" 2>/dev/null || true
    curl --max-time 20 -s -o "$tmp_v6" "$PIA_SERVERLIST_V6_URL" 2>/dev/null || true

    local line_v7 line_v6
    line_v7=$(head -n 1 "$tmp_v7" 2>/dev/null || echo "{}")
    line_v6=$(head -n 1 "$tmp_v6" 2>/dev/null || echo "{}")

    # Merge unique regions from v7 and v6 using jq
    echo "$line_v7" "$line_v6" | jq -s -c '{regions: (([.[0].regions // [], .[1].regions // []] | add) | unique_by(.id))}' > "$tmp_merged" 2>/dev/null || cp "$tmp_v7" "$tmp_merged" 2>/dev/null || true

    local token
    token=$(curl --max-time 30 -s -d "username=$PIA_USER&password=$PIA_PASS" "$PIA_TOKEN_URL" | jq -r '.token')

    if [ -z "$token" ] || [ "$token" = "null" ]; then
        log_msg "API ERROR: Failed to get auth token from PIA."
        rm -f "$tmp_v7" "$tmp_v6" "$tmp_merged" 2>/dev/null || true
        return 1
    fi

    # Determine last connected region to enforce strict Round-Robin progression
    local last_region
    last_region=$(cat /tmp/pia_last_region 2>/dev/null || nvram get "${TUNNEL_IF}_last_region" 2>/dev/null || echo "")

    local ordered_regions=""
    local seen=0
    for r in $PIA_REGION_IDS; do
        if [ "$seen" -eq 1 ]; then
            ordered_regions="$ordered_regions $r"
        elif [ "$r" = "$last_region" ]; then
            seen=1
        fi
    done
    for r in $PIA_REGION_IDS; do
        if [ "$r" = "$last_region" ]; then
            break
        fi
        ordered_regions="$ordered_regions $r"
    done
    ordered_regions=$(echo "$ordered_regions" | sed 's/^ *//')
    if [ -z "$ordered_regions" ]; then
        ordered_regions="$PIA_REGION_IDS"
    fi

    log_msg "Round-robin region search order: $ordered_regions (Last: ${last_region:-none})"

    for region_id in $ordered_regions; do
        local region_json wg_servers_json server_count random_index wg_ip wg_cn region_name
        region_json=$(head -n 1 "$tmp_merged" | jq --arg REGION_ID "$region_id" '.regions[] | select(.id == $REGION_ID and .offline == false and (.servers.wg | length) > 0)')

        if [ -z "$region_json" ]; then continue; fi

        region_name=$(echo "$region_json" | jq -r '.name')
        wg_servers_json=$(echo "$region_json" | jq '.servers.wg')
        server_count=$(echo "$wg_servers_json" | jq 'length')
        
        # Pick a truly random server index within this region via /dev/urandom
        random_index=$(get_random_num "$server_count")
        wg_ip=$(echo "$wg_servers_json" | jq -r ".[$random_index].ip")
        wg_cn=$(echo "$wg_servers_json" | jq -r ".[$random_index].cn")

        if [ ! -f "$CERT_FILE" ]; then
            curl --max-time 30 -s -o "$CERT_FILE" "$PIA_CA_CERT_URL"
        fi

        local pubkey_encoded token_encoded add_key_url conn_json status peer_ip server_key dns1 dns2
        pubkey_encoded=$(echo "$pubkey" | sed 's/+/%2B/g; s/\//%2F/g; s/=/%3D/g')
        token_encoded=$(echo "$token" | sed 's/+/%2B/g; s/\//%2F/g; s/=/%3D/g')
        add_key_url="https://$wg_cn:1337/addKey?pt=${token_encoded}&pubkey=${pubkey_encoded}"

        conn_json=$(curl --max-time 30 -s -G --cacert "$CERT_FILE" --connect-to "$wg_cn:1337:$wg_ip:1337" "$add_key_url")
        status=$(echo "$conn_json" | jq -r '.status')

        if [ "$status" != "OK" ]; then continue; fi

        peer_ip=$(echo "$conn_json" | jq -r '.peer_ip')
        server_key=$(echo "$conn_json" | jq -r '.server_key')
        dns1=$(echo "$conn_json" | jq -r '.dns_servers[0]')
        dns2=$(echo "$conn_json" | jq -r '.dns_servers[1]')

        log_msg "Obtained new config for $region_name ($wg_ip)"

        # Apply to NVRAM safely
        nvram set "${TUNNEL_IF}_label=PIA-$region_name"
        nvram set "${TUNNEL_IF}_namep0=PIA-$region_name"
        nvram set "${TUNNEL_IF}_private=$privkey"
        nvram set "${TUNNEL_IF}_ipaddr=$peer_ip"
        nvram set "${TUNNEL_IF}_ipaddrmask=$peer_ip/32"
        nvram set "${TUNNEL_IF}_dns=$dns1,$dns2"
        nvram set "${TUNNEL_IF}_rem0=$wg_ip"
        nvram set "${TUNNEL_IF}_peerkey0=$server_key"
        nvram set "${TUNNEL_IF}_peerport0=1337"
        nvram set "${TUNNEL_IF}_ka0=25"
        nvram set "${TUNNEL_IF}_aip0=0.0.0.0/0"
        nvram set "${TUNNEL_IF}_killswitch=1"
        nvram set "${TUNNEL_IF}_en=1"
        nvram set "${TUNNEL_IF}_failgrp=1"
        nvram set "${TUNNEL_IF}_last_region=$region_id"
        nvram commit

        echo "$region_id" > /tmp/pia_last_region 2>/dev/null || true
        rm -f "$tmp_v7" "$tmp_v6" "$tmp_merged" 2>/dev/null || true
        return 0
    done

    log_msg "API ERROR: Could not find working region."
    rm -f "$tmp_v7" "$tmp_v6" "$tmp_merged" 2>/dev/null || true
    return 1
}

test_and_restore_tunnel() {
    log_msg "Rebuilding firewall and applying tunnel settings..."
    /etc/config/eop-tunnel.prewall

    # Read DNS back from NVRAM to ping test
    local test_dns
    test_dns=$(nvram get "${TUNNEL_IF}_dns" | cut -d',' -f1)

    log_msg "Waiting up to 60s for WireGuard handshake..."

    local i=1
    while [ "$i" -le 12 ]; do
        if ping -c 1 -W 2 -I "$TUNNEL_IF" "$test_dns" >/dev/null 2>&1; then
            log_msg "SUCCESS: Tunnel is up and passing traffic."
            # Set internal zero-log PIA DNS to prevent DNS leaks
            printf "nameserver %s\nnameserver 10.0.0.243\n" "$test_dns" > /etc/resolv.conf
            return 0
        fi
        sleep 5
        i=$((i + 1))
    done

    log_msg "FAILURE: Tunnel handshake failed."
    stopservice "$TUNNEL_IF"
    return 1
}

# --- Main Watchdog Loop ---

main() {
    acquire_lock
    load_credentials
    log_msg "--- PIA Watchdog Daemon Started ---"

    # Default to FAIL-CLOSED on startup: never expose LAN before health is verified
    block_lan_internet
    ensure_luna_access

    while true; do
        # 1. Normal State: Check VPN Health
        if ping -c 3 -W 2 "$VPN_CHECK_IP" >/dev/null 2>&1; then
            # Ensure Luna router (10.20.20.1) rules remain top priority
            ensure_luna_access
            unblock_lan_internet
            sleep $HEALTH_CHECK_INTERVAL
            continue
        fi

        # 2. Failure Detected: Enter Recovery Mode
        log_msg "🚨 VPN Failure Detected. Initiating Lockdown."
        send_pushover "VPN Down" "Tunnel lost. Engaging killswitch." "1"

        block_lan_internet
        disable_tunnel

        local backoff=$BACKOFF_BASE

        # 3. Recovery Loop
        while true; do
            log_msg "Checking raw ISP connectivity ($RAW_CHECK_IP)..."
            if ping -c 3 -W 2 "$RAW_CHECK_IP" >/dev/null 2>&1; then
                log_msg "ISP is UP. Attempting PIA API rotation..."
                printf "nameserver 9.9.9.9\nnameserver 149.112.112.112\n" > /etc/resolv.conf

                if get_pia_config && test_and_restore_tunnel; then
                    log_msg "✅ VPN Recovered. Lifting killswitch."
                    unblock_lan_internet
                    send_pushover "VPN Restored" "Tunnel recovered successfully." "0"
                    break # Break out of recovery back to normal monitoring
                else
                    log_msg "PIA rotation failed. Backing off for ${backoff}s."
                fi
            else
                log_msg "ISP is DOWN. Waiting out outage. Backing off for ${backoff}s."
            fi

            # Exponential backoff scaling
            sleep "$backoff"
            backoff=$((backoff * 2))
            if [ "$backoff" -gt "$MAX_BACKOFF" ]; then
                backoff=$MAX_BACKOFF
            fi
        done
    done
}

# Run the daemon
main