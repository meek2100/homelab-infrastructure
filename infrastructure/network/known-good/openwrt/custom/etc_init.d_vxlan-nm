#!/bin/sh /etc/rc.common
# vxlan-nm - Manage and monitor VXLAN bridging on OpenWrt.
USE_PROCD=1
START=99
STOP=10

start_service() {
    logger -t vxlan-nm "Starting VXLAN Network Manager"
    procd_open_instance
    procd_set_param command /usr/bin/vxlan-nm
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 3600 5 5
    procd_close_instance
}

stop_service() {
    logger -t vxlan-nm "Stopping VXLAN Network Manager"
    killall vxlan-nm 2>/dev/null

    # Clean up the interface to prevent bridging loops
    . /etc/vxlan-nm.conf
    ip link set "$VXLAN_IF" down 2>/dev/null
    ip link delete "$VXLAN_IF" type vxlan 2>/dev/null
}

reload_service() {
    logger -t vxlan-nm "Reloading config via SIGHUP"
    kill -HUP $(pidof vxlan-nm) 2>/dev/null || {
        logger -t vxlan-nm "vxlan-nm not running, starting..."
        start_service
    }
}

status() {
    pgrep vxlan-nm >/dev/null && echo "vxlan-nm is running" || echo "vxlan-nm is not running"
}