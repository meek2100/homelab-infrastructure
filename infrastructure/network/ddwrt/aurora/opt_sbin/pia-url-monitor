#!/bin/sh
export PATH="/opt/bin:/opt/sbin:/bin:/sbin:/usr/bin:/usr/sbin"
# ==============================================================================
# Title:        PIA URL Accessibility Monitor (POSIX NATIVE)
# Description:  Checks if a list of URLs are blocking the current VPN IP. 
#               If blocked (e.g., 403, 503), it logs the error and the endpoint,
#               then kills the tunnel to force the Watchdog to rotate servers.
# ==============================================================================

# Ensure curl is available
if ! command -v curl >/dev/null 2>&1; then
    logger -t "PIA_URL_Monitor" "ERROR: curl binary not found in PATH."
    exit 0
fi

# Space-separated list of mirror URLs to monitor
readonly TARGET_URLS="https://audiobookbay.lu https://audiobookbay.se https://audiobookbay.fi https://audiobookbay.nl https://audiobookbay.is"
readonly TUNNEL_IF="oet1"
readonly USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:109.0) Gecko/20100101 Firefox/115.0"
readonly RAW_CHECK_IP="9.9.9.9" # Quad9 Anycast (Swiss foundation)

# Abort if the Watchdog is currently in recovery mode
if [ -f /tmp/pia_recovery.active ]; then
    exit 0
fi

# 1. Verify basic internet first via Quad9
if ! ping -c 1 -W 2 "$RAW_CHECK_IP" >/dev/null 2>&1; then
    exit 0 
fi

# 2. Iterate through all target URLs and tally success
TOTAL_URLS=0
FAILED_URLS=0
BLOCKED_DETAILS=""

for url in $TARGET_URLS; do
    TOTAL_URLS=$((TOTAL_URLS + 1))

    # Fetch HTTP response code (-k allows checking even if Cloudflare mirror SSL is temporarily unaligned)
    HTTP_CODE=$(curl -k -s -L -A "$USER_AGENT" -o /dev/null -w "%{http_code}" --max-time 10 "$url" 2>/dev/null || echo "000")

    case "$HTTP_CODE" in
        200|201|301|302|307|308)
            # Healthy response! At least one mirror is working cleanly.
            logger -t "PIA_URL_Monitor" "Mirror healthy: ${url} returned HTTP ${HTTP_CODE}."
            exit 0
            ;;
        *)
            # Mirror failed or blocked (e.g. 403, 503, 000, 520)
            FAILED_URLS=$((FAILED_URLS + 1))
            BLOCKED_DETAILS="${BLOCKED_DETAILS} [${url}: HTTP ${HTTP_CODE}]"
            ;;
    esac
done

# 3. Only rotate if ALL targets failed
if [ "$FAILED_URLS" -ge "$TOTAL_URLS" ] && [ "$TOTAL_URLS" -gt 0 ]; then
    REGION=$(nvram get "${TUNNEL_IF}_label" | sed 's/PIA-//')
    REMOTE_IP=$(nvram get "${TUNNEL_IF}_rem0")

    logger -t "PIA_URL_Monitor" "ALL ${TOTAL_URLS} mirrors failed!${BLOCKED_DETAILS} via ${REGION} (${REMOTE_IP}). Triggering rotation."

    stopservice "$TUNNEL_IF" >/dev/null 2>&1 || true
    ip link set "$TUNNEL_IF" down >/dev/null 2>&1 || true
    /opt/sbin/pia-rotate >/dev/null 2>&1 || true
fi