# /etc/fstab: static file system information.
#
# Use 'blkid' to print the universally unique identifier for a
# device; this may be used with UUID= as a more robust way to name devices
# that works even if disks are added and removed. See fstab(5).
#
# systemd generates mount units based on this file, see systemd.mount(5).
# Please run 'systemctl daemon-reload' after making changes here.
#
# <file system> <mount point>   <type>  <options>       <dump>  <pass>
# / was on /dev/sda1 during installation
UUID=a30085c6-16a4-4740-8d5b-e3edf235cdf0 /               ext4    errors=remount-ro 0       1
# swap was on /dev/sda5 during installation
UUID=342820f6-43dc-4243-b041-3afe7cad6244 none            swap    sw              0       0
/dev/sr0        /media/cdrom0   udf,iso9660 user,noauto     0       0


# NFS Share for Media
# hard: writers pause during a NAS outage and resume (soft could half-write data, and makes Plex treat
# files as missing). _netdev,nofail,x-systemd.mount-timeout=30: boot never hangs if the NAS is down.
192.168.40.248:/media /mnt/media nfs nfsvers=4.2,hard,_netdev,nofail,x-systemd.mount-timeout=30 0 0

# Wireshark capture archive (stack 48): soft so a NAS outage returns an error after ~1 min instead of
# hanging the capture container; nofail so luna still boots if the NAS is down.
192.168.40.248:/media/wireshark-captures /mnt/captures nfs nfsvers=4.2,soft,timeo=100,retrans=3,_netdev,nofail 0 0

# SMB Share for Media
# //192.168.40.248/media /mnt/media cifs credentials=/root/.smbcredentials,uid=1000,gid=1000 0 0
