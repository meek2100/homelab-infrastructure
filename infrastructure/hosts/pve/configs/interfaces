auto lo
iface lo inet loopback

iface lan0 inet manual

iface lan1 inet manual

auto vmbr0
iface vmbr0 inet static
	address 192.168.1.250/24
	gateway 192.168.1.1
	bridge-ports lan0
	bridge-stp off
	bridge-fd 0
	bridge-vlan-aware yes
	bridge-vids 2-4094
	bridge-pvid 1

auto vmbr1
iface vmbr1 inet manual
	bridge-ports lan1
	bridge-stp off
	bridge-fd 0
	bridge-vlan-aware yes
	bridge-vids 2-4094
	bridge-pvid 1
	post-up ip link set dev lan1 promisc on

source /etc/network/interfaces.d/*
