#!/bin/sh
export PATH="/opt/bin:/opt/sbin:/bin:/sbin:/usr/bin:/usr/sbin"
echo "--> Forcing instant PIA WireGuard rotation..."

# 1. Kill the currently running watchdog instances cleanly
killall -9 pia-watchdog 2>/dev/null || true
rm -rf /tmp/pia_watchdog.lock 2>/dev/null || true
sleep 1

# 2. Immediately enforce fail-closed killswitch on physical WAN
touch /tmp/pia_recovery.active 2>/dev/null || true
wan_if=$(nvram get wan_iface)
[ -z "$wan_if" ] && wan_if="vlan2"

iptables -C FORWARD -i br0 -o "$wan_if" -j REJECT 2>/dev/null || iptables -I FORWARD -i br0 -o "$wan_if" -j REJECT

# Restrict Luna transit strictly to management (SSH 22, HTTP 80, HTTPS 443)
# Accessible from 192.168.1.0/24 (VLAN 1), 192.168.10.0/24 (VLAN 10), and local LAN (10.25.25.0/24)
iptables -D FORWARD -d 10.20.20.0/24 -j ACCEPT 2>/dev/null || true
iptables -D FORWARD -s 10.20.20.0/24 -j ACCEPT 2>/dev/null || true
iptables -D FORWARD -d 10.20.20.1 -j ACCEPT 2>/dev/null || true
iptables -D FORWARD -s 10.20.20.1 -j ACCEPT 2>/dev/null || true
iptables -t nat -D POSTROUTING -d 10.20.20.0/24 -j MASQUERADE 2>/dev/null || true
iptables -t nat -D POSTROUTING -d 10.20.20.1 -j MASQUERADE 2>/dev/null || true

iptables -D FORWARD -s 10.20.20.1 -m state --state ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || true
for src_net in 192.168.1.0/24 192.168.10.0/24 10.25.25.0/24; do
    for port in 22 80 443; do
        iptables -D FORWARD -i br0 -s "$src_net" -d 10.20.20.1 -p tcp --dport "$port" -j ACCEPT 2>/dev/null || true
        iptables -D FORWARD -p tcp -d 10.20.20.1 --dport "$port" -j ACCEPT 2>/dev/null || true
    done
done
iptables -D FORWARD -p tcp -s 10.20.20.1 --sport 22 -m state --state ESTABLISHED -j ACCEPT 2>/dev/null || true

iptables -I FORWARD 1 -s 10.20.20.1 -m state --state ESTABLISHED,RELATED -j ACCEPT
for src_net in 192.168.1.0/24 192.168.10.0/24 10.25.25.0/24; do
    for port in 22 80 443; do
        iptables -I FORWARD 2 -i br0 -s "$src_net" -d 10.20.20.1 -p tcp --dport "$port" -j ACCEPT
    done
done

for port in 22 80 443; do
    if ! iptables -t nat -C POSTROUTING -o "$wan_if" -d 10.20.20.1 -p tcp --dport "$port" -j MASQUERADE 2>/dev/null; then
        iptables -t nat -I POSTROUTING 1 -o "$wan_if" -d 10.20.20.1 -p tcp --dport "$port" -j MASQUERADE
    fi
done

# Arm temporary rotation egress filter on physical WAN (bare minimum: Luna mgmt, NTP, PIA endpoints)
iptables -N WAN_EGRESS_FILTER 2>/dev/null || true
iptables -F WAN_EGRESS_FILTER 2>/dev/null || true
for port in 22 80 443; do
    iptables -A WAN_EGRESS_FILTER -d 10.20.20.1 -p tcp --dport "$port" -j ACCEPT
done
iptables -A WAN_EGRESS_FILTER -p udp --dport 123 -j ACCEPT
iptables -A WAN_EGRESS_FILTER -p udp --dport 53 -j ACCEPT
iptables -A WAN_EGRESS_FILTER -p tcp --dport 53 -j ACCEPT
iptables -A WAN_EGRESS_FILTER -p tcp --dport 443 -j ACCEPT
iptables -A WAN_EGRESS_FILTER -p tcp --dport 1337 -j ACCEPT
iptables -A WAN_EGRESS_FILTER -p udp --dport 1337 -j ACCEPT
iptables -A WAN_EGRESS_FILTER -p udp --dport 51820 -j ACCEPT
iptables -A WAN_EGRESS_FILTER -p icmp -j ACCEPT
iptables -A WAN_EGRESS_FILTER -d 10.25.25.0/24 -j ACCEPT
iptables -A WAN_EGRESS_FILTER -j REJECT
if ! iptables -C OUTPUT -o "$wan_if" -j WAN_EGRESS_FILTER 2>/dev/null; then
    iptables -I OUTPUT -o "$wan_if" -j WAN_EGRESS_FILTER
fi

# 3. Take down the tunnel (Forces watchdog into fresh rotation)
ip link set oet1 down 2>/dev/null || ifconfig oet1 down 2>/dev/null || true

# 4. Start fresh watchdog daemon
rm -f /tmp/pia-startup-crash.log
/opt/sbin/pia-watchdog > /tmp/pia-startup-crash.log 2>&1 &

echo "--> Rotation initiated. Waiting for WireGuard handshake..."
i=1
while [ "$i" -le 15 ]; do
    sleep 2
    if ip link show oet1 >/dev/null 2>&1 && ping -c 1 -W 2 -I oet1 10.0.0.242 >/dev/null 2>&1; then
        label=$(nvram get oet1_label 2>/dev/null || echo "PIA")
        peer=$(nvram get oet1_rem0 2>/dev/null || echo "")
        echo "--> SUCCESS: WireGuard tunnel (oet1) is UP and connected to $label ($peer)!"
        exit 0
    fi
    i=$((i + 1))
done

echo "--> NOTE: WireGuard tunnel recovery in progress. Check '/tmp/pia-startup-crash.log' for details."

